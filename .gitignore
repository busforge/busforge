# build output
**/bin/
**/obj/
**/dist/
node_modules/

# user-supplied, never commit (proprietary project + manufacturer data)
*.knxproj
*.knxprod
*.knxkeys
# except small synthetic test fixtures (no proprietary data)
!packages/**/test/fixtures/*.knxproj

# server runtime state
apps/server/data/

# local device backups / scratch
*.bin
# repo scratchpad: bench captures + throwaway analysis scripts, kept locally only
scratchpad/

# os
.DS_Store

# reference-only C# spike (kept locally, never in git)
/reference/

# local session state
.remember
*.tsbuildinfo

# playwright-cli artifacts (snapshots, console logs, screenshots)
**/.playwright-cli/
# deployment overlay: image registry, storage path and proxy wiring of one site
docker-compose.deploy.yml
# local git worktrees
.worktrees/
# hardware smoke-run report artifacts (evidence, regenerated per run)
tools/smoke/reports/

# Local engineering tickets, specs and investigation notes
/.scratch/
