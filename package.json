{
  "name": "busforge",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "plugins/*"],
  "scripts": {
    "knx": "bun run packages/knx/src/cli.ts",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "bun run --filter='*' test",
    "typecheck": "tsc --noEmit",
    "build:web": "bun run --cwd apps/web build",
    "check": "bun run typecheck && bun run test && bun run build:web"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3"
  }
}
