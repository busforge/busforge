{
  "name": "busforge",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": ["packages/*", "apps/*", "plugins/*", "tools"],
  "scripts": {
    "knx": "bun run packages/knx/src/cli.ts",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "oxlint --type-aware --deny-warnings packages apps plugins tools",
    "test": "bun run --filter='*' test",
    "build": "bun run --filter='*' build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run corpus:status",
    "corpus:status": "bun run tools/corpus-status.ts",
    "smoke": "bun run tools/smoke/runner.ts --report"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3"
  }
}
