{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {},
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.d.ts", "reference/**", "scratchpad/**"],
  "rules": {
    "typescript/switch-exhaustiveness-check": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",

    "no-empty": ["error", { "allowEmptyCatch": false }],
    "typescript/only-throw-error": "error",
    "typescript/no-base-to-string": "error",

    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",

    "no-unused-vars": "off",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts", "tools/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "tools/smoke/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            { "name": "node:fs", "importNames": ["default", "mkdtemp", "mkdtempSync"], "message": "Use tempDir() from tools/test-temp.ts: it removes the directory when the test process ends." },
            { "name": "node:fs/promises", "importNames": ["default", "mkdtemp"], "message": "Use tempDir() from tools/test-temp.ts: it removes the directory when the test process ends." },
            { "name": "fs", "importNames": ["default", "mkdtemp", "mkdtempSync"], "message": "Use tempDir() from tools/test-temp.ts: it removes the directory when the test process ends." },
            { "name": "fs/promises", "importNames": ["default", "mkdtemp"], "message": "Use tempDir() from tools/test-temp.ts: it removes the directory when the test process ends." }
          ]
        }]
      }
    }
  ]
}
